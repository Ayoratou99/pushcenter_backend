# =============================================================================
# AninfPush API
# =============================================================================
# Copy to .env, then fill in ONLY the values marked "CHANGE ME". Everything else
# is already wired for the Docker Compose stack: the hostnames below are the
# compose service names, so nothing else needs touching.
#
#   cp .env.example .env
#   docker compose run --rm --no-deps app php artisan key:generate --show
#   # paste the value into APP_KEY, set the three passwords, then:
#   docker compose up -d --build
#   docker compose exec app php artisan admin:create --email=... --password=...
#
# Running without Docker? See "LOCAL DEVELOPMENT" at the bottom.
# =============================================================================

APP_NAME=AninfPush
APP_ENV=production
# CHANGE ME — required, and it must never change afterwards: it encrypts the
# users' Google Authenticator secrets. Generate with:
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — MySQL, the `db` service of docker-compose.yml
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aninfpush
DB_USERNAME=aninfpush_user
# CHANGE ME — compose creates the MySQL user with this very password.
DB_PASSWORD=
# CHANGE ME — MySQL root password, different from the one above.
DB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Redis — the `redis` service, and the backend for cache, sessions and queues
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# CHANGE ME — compose starts Redis with --requirepass using this value.
REDIS_PASSWORD=

# Everything below runs on Redis. Horizon needs QUEUE_CONNECTION=redis: on any
# other driver the queue is not supervised and messages are never delivered.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=aninfpush_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Authentication — JWT + mandatory Google Authenticator
# -----------------------------------------------------------------------------
# Left empty, it falls back to APP_KEY, which is fine to start with. Give it its
# own value in production so it can be rotated without touching the encryption
# of the two-factor secrets:
#   echo "JWT_SECRET=$(openssl rand -hex 32)"
JWT_SECRET=
JWT_ALGO=HS256
# Access token lifetime, in minutes.
JWT_ACCESS_TTL=60
# Refresh token lifetime, in minutes (14 days).
JWT_REFRESH_TTL=20160
# Lifetime of the tokens issued to applications (client credentials), in minutes.
JWT_APPLICATION_TTL=60
JWT_AUDIENCE=aninfpush
JWT_LEEWAY=10

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Origin of the management console: scheme + host + port, no trailing slash and
# no path. Only browser requests from here are accepted, and it is also what
# allows the console to embed the API documentation.
# The frontend compose file publishes on port 80, hence http://localhost.
FRONTEND_URL=http://localhost

# Extra origins, comma separated (staging console, customer dashboard).
CORS_ALLOWED_ORIGINS=

# How long a browser may cache the preflight answer, in seconds.
CORS_MAX_AGE=3600

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Customer emails go out through each application's own SMTP settings, managed
# from the console. This mailer is only the framework default.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aninfpush.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS (optional, for S3 storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# LOCAL DEVELOPMENT (without Docker)
# =============================================================================
# The hostnames above are compose service names and do not resolve outside the
# stack. Override them:
#
#   APP_ENV=local
#   APP_DEBUG=true
#   LOG_LEVEL=debug
#   DB_HOST=127.0.0.1
#   REDIS_HOST=127.0.0.1
#   FRONTEND_URL=http://localhost:3039     # `npm run dev` port
#
# Redis must still be reachable: Horizon and the rate limiting depend on it.
# The test suite needs none of this, it runs on in-memory SQLite.
# =============================================================================
